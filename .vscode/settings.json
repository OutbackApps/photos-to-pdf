{
    // Formatting (as .editorconfig, for anyone without its extension).
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[markdown]": {
        "files.trimTrailingWhitespace": false
    },

    // Not searched or watched: installed packages, Bun's lockfile, the downloaded test browser and the built popup.
    "search.exclude": {
        "node_modules": true,
        "bun.lock": true,
        ".cache": true,
        "**/*.gen.ts": true
    }
}
