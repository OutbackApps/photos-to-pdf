{
    "$schema": "./node_modules/@servicem8/addon-kit/addon-schema.json",

    // The add-on's unique identifier. Deploys create or update the add-on with this slug,
    // so changing it creates a NEW add-on.
    "slug": "photos-to-pdf",

    "name": "Photos to PDF",
    // Bump this whenever the add-on changes.
    "version": "1.5",

    // The function's entry point, bundled by `addon-kit deploy`.
    "main": "index.js",

    "oauth": {
        "scope": "read_jobs read_attachments manage_attachments"
    },

    // Settings → Preferences → Add-ons in ServiceM8 (web): the function gets them in event.preferences.
    // Addon Kit 1.3.1 warns that preferences have no effect; ServiceM8's manifest reference says otherwise.
    // The default must match DEFAULT_NAME in index.js (a test checks).
    "preferences": [
        {
            "key": "pdf_name",
            "name": "PDF name",
            "type": "text",
            "default": "Job #{job.generated_job_id} Photos[ - PO {job.purchase_order_number}]",
            "description": "Job fields go in braces, e.g. {job.generated_job_id}, {job.job_address}. Text in [ ] is left out when a field in it is empty. \" (1 of 3)\" is added when there are several PDFs. Can be changed before saving.",
            "maxLength": 200
        }
    ],

    // The job card button: on the web (a modal popup) and in the app.
    // The icon is icon.png from this repo, served by jsDelivr, pinned to a commit: jsDelivr serves that
    // at once and it never changes (@main can lag by hours). After changing icon.png, push it and put
    // the new commit here. ServiceM8 needs it at least 171 x 171.
    "actions": [
        {
            "name": "Photos to PDF",
            "type": "online",
            "entity": "job",
            "iconURL": "https://cdn.jsdelivr.net/gh/OutbackApps/photos-to-pdf@0022c65/icon.png",
            "event": "photos_to_pdf",
            "location": "modal"
        },
        {
            "name": "Photos to PDF",
            "type": "app",
            "entity": "job",
            "iconURL": "https://cdn.jsdelivr.net/gh/OutbackApps/photos-to-pdf@0022c65/icon.png",
            "event": "photos_to_pdf"
        }
    ]
}
