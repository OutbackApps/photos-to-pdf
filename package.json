{
    "name": "photos-to-pdf",
    "version": "1.0.0",
    "private": true,
    "description": "ServiceM8 add-on: Turn a job's photos into PDFs, saved straight to the job diary.",
    "license": "UNLICENSED",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "testBrowser": {
        "browser": "chrome",
        "buildId": "155.0.8059.79"
    },
    "scripts": {
        "test": "bun test",
        "typecheck": "bun run build && tsc --noEmit",
        "spell": "cspell --no-progress --gitignore .",
        "build": "bun scripts/build-page.ts",
        "browser": "bun scripts/browser.ts",
        "postinstall": "bun scripts/browser.ts",
        "login": "addon-kit login --scopes \"read_jobs read_attachments manage_attachments\"",
        "whoami": "addon-kit whoami",
        "check": "bun run build && addon-kit deploy --dry-run",
        "deploy": "bun run build && addon-kit deploy",
        "tail": "addon-kit tail"
    },
    "devDependencies": {
        "@puppeteer/browsers": "2.13.2",
        "@servicem8/addon-kit": "^1.3.1",
        "@types/bun": "1.4.3",
        "cspell": "10.3.6",
        "pdfjs-dist": "^4.10.38",
        "puppeteer-core": "^24.43.1",
        "typescript": "7.0.2"
    }
}
