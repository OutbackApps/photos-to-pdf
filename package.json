{
  "name": "photos-to-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "ServiceM8 add-on: Turn a job's photos into PDFs, saved straight to the job diary.",
  "license": "UNLICENSED",
  "main": "index.js",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "login": "addon-kit login --scopes \"read_jobs read_attachments manage_attachments\"",
    "whoami": "addon-kit whoami",
    "check": "addon-kit deploy --dry-run",
    "deploy": "addon-kit deploy",
    "tail": "addon-kit tail"
  },
  "devDependencies": {
    "@servicem8/addon-kit": "^1.3.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^24.43.1"
  }
}
